{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "description": "Using compilers: C = /usr/bin/gcc, CXX = /usr/bin/g++ (GCC 14.2.1 x86_64-redhat-linux)",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}